{
  "name": "tech-demo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js *.config.mjs --max-warnings 0",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src tests *.config.ts *.config.mjs",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src tests *.config.ts *.config.mjs",
    "test:unit": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "npm run build && node node_modules/@playwright/test/cli.js test",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "test:shots": "npm run build && node node_modules/@playwright/test/cli.js test -c playwright.diagnostics.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@babylonjs/loaders": "^9.28.0"
  }
}
