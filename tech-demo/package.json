  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint *.config.mjs --max-warnings 0",
    "format": "prettier --write src tests *.config.ts *.config.mjs",
    "format:check": "prettier --check src tests *.config.ts *.config.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
